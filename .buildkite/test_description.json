{
  "tests": [
    {
      "test_name": "build-gnu",
      "command": "RUSTFLAGS=\"-D warnings\" cargo all-features build -p {crate} --release --all-targets",
      "platform": ["x86_64", "aarch64"]
    },
    {
      "test_name": "build-gnu",
      "command": "RUSTFLAGS=\"-D warnings\" cargo build -p {crate} --all-features --release --all-targets",
      "platform": ["riscv64"]
    },
    {
      "test_name": "build-musl",
      "command": "RUSTFLAGS=\"-D warnings\" cargo all-features build -p {crate} --release --target {target_platform}-unknown-linux-musl --all-targets",
      "platform": ["x86_64", "aarch64"]
    },
    {
      "test_name": "style",
      "scope": "workspace",
      "command": "cargo fmt --all -- --check --config format_code_in_doc_comments=true"
    },
    {
      "test_name": "doc",
      "command": "RUSTDOCFLAGS=\"-D warnings\" RUSTFLAGS=\"--cfg RUSTDOC_disable_feature_compat_errors\" cargo doc -p {crate} --all-features --no-deps"
    },
    {
      "test_name": "unittests-gnu",
      "command": "cargo all-features test -p {crate}",
      "platform": ["x86_64", "aarch64"],
      "docker_plugin": {"privileged": true}
    },
    {
      "test_name": "unittests-gnu",
      "command": "cargo test -p {crate} --all-features",
      "platform": ["riscv64"],
      "docker_plugin": {"privileged": true}
    },
    {
      "test_name": "unittests-musl",
      "command": "cargo all-features test -p {crate} --target {target_platform}-unknown-linux-musl",
      "platform": ["x86_64", "aarch64"],
      "docker_plugin": {"privileged": true}
    },
    {
      "test_name": "unittests-gnu-release",
      "command": "cargo all-features test -p {crate} --release",
      "platform": ["x86_64", "aarch64"],
      "docker_plugin": {"privileged": true}
    },
    {
      "test_name": "unittests-gnu-release",
      "command": "cargo test -p {crate} --all-features --release",
      "platform": ["riscv64"],
      "docker_plugin": {"privileged": true}
    },
    {
      "test_name": "unittests-musl-release",
      "command": "cargo all-features test -p {crate} --release --target {target_platform}-unknown-linux-musl",
      "platform": ["x86_64", "aarch64"],
      "docker_plugin": {"privileged": true}
    },
    {
      "test_name": "clippy",
      "command": "cargo all-features clippy -p {crate} --all-targets -- -D warnings -D clippy::undocumented_unsafe_blocks",
      "platform": ["x86_64", "aarch64"]
    },
    {
      "test_name": "clippy",
      "command": "cargo clippy -p {crate} --all-features --all-targets -- -D warnings -D clippy::undocumented_unsafe_blocks",
      "platform": ["riscv64"]
    },
    {
      "test_name": "coverage",
      "command": "cd {crate_path} && pytest --test-scope=crate $(find \"$(git rev-parse --show-toplevel)\" -path \"*/integration_tests/test_coverage.py\")",
      "docker_plugin": {"privileged": true},
      "platform": ["x86_64"]
    },
    {
      "test_name": "cross-crate-check",
      "scope": "workspace",
      "command": "cargo check --workspace --all-targets",
      "platform": ["x86_64"]
    },
    {
      "test_name": "commit-format",
      "scope": "workspace",
      "command": "pytest $(find . -type f -name \"test_commit_format.py\")",
      "docker_plugin": {"propagate-environment": true}
    }
  ]
}

